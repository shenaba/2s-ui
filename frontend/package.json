{
  "name": "2s-ui-frontend",
  "version": "1.5.2",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "dev:subscriber": "vite -c subscriber/vite.config.mts",
    "build": "vue-tsc --noEmit && vite build && npm run build:subscriber",
    "build:subscriber": "vue-tsc --noEmit -p subscriber/tsconfig.json && vite build -c subscriber/vite.config.mts",
    "preview": "vite preview",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.20.0",
    "clipboard": "^2.0.11",
    "echarts": "^6.1.0",
    "notivue": "^2.4.5",
    "pinia": "^4.1.0",
    "qrcode.vue": "^3.11.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vue3-persian-datetime-picker": "^1.2.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
