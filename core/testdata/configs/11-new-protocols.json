{
  "log": {
    "level": "error"
  },
  "inbounds": [
    {
      "type": "snell",
      "tag": "snell-v6-in",
      "listen": "127.0.0.1",
      "listen_port": 42101,
      "version": 6,
      "psk": "snell-pre-shared-key",
      "mode": "default"
    },
    {
      "type": "snell",
      "tag": "snell-v5-in",
      "listen": "127.0.0.1",
      "listen_port": 42102,
      "version": 5,
      "psk": "snell-pre-shared-key",
      "obfs_mode": "http"
    },
    {
      "type": "hysteria2",
      "tag": "hy2-gecko-in",
      "listen": "127.0.0.1",
      "listen_port": 42104,
      "users": [{"name": "u", "password": "hunter2"}],
      "bbr_profile": "conservative",
      "obfs": {
        "type": "gecko",
        "password": "hunter2",
        "min_packet_size": 100,
        "max_packet_size": 1200
      },
      "tls": {"enabled": true, "certificate_path": "__CERT__", "key_path": "__KEY__"}
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "snell",
      "tag": "snell-out",
      "server": "127.0.0.1",
      "server_port": 42101,
      "version": 6,
      "psk": "snell-pre-shared-key"
    }
  ],
  "services": [
    {
      "type": "oom-killer",
      "tag": "oom",
      "memory_limit": "1gb"
    },
    {
      "type": "hysteria-realm",
      "tag": "realm",
      "listen": "127.0.0.1",
      "listen_port": 42103,
      "users": [
        {
          "name": "realm-user",
          "token": "realm-token",
          "max_realms": 2
        }
      ]
    }
  ]
}
